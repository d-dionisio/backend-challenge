POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wagering
POSTGRES_PORT=5432

DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering?sslmode=disable
HTTP_ADDRESS=:8080
APP_PORT=8080

REFERENCE_POLL_INTERVAL=1s
REFERENCE_ATTEMPT_TIMEOUT=5s
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_INITIAL_DELAY=1s
REFERENCE_MAX_DELAY=1m

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=14566
SQS_ENDPOINT=http://localhost:14566
SQS_EVENTS_QUEUE_URL=http://localhost:14566/queue/us-east-1/000000000000/wager-events
SQS_WAGERS_QUEUE_URL=http://localhost:14566/queue/us-east-1/000000000000/wager-transactions.fifo
SQS_PROVIDER_BY_SENDER={"000000000000":"provider-a"}
SQS_PROCESSING_TIMEOUT=5s

OUTBOX_POLL_INTERVAL=1s
OUTBOX_ATTEMPT_TIMEOUT=5s
OUTBOX_LEASE_DURATION=30s
OUTBOX_INITIAL_DELAY=1s
OUTBOX_MAX_DELAY=1m

KEYCLOAK_PORT=18080
# Compose usa http://keycloak:8080 como issuer. Para API executada no host,
# inicie apenas as dependencias e configure KEYCLOAK_HOSTNAME=http://localhost:18080.
KEYCLOAK_HOSTNAME=http://keycloak:8080
OIDC_ISSUER_URL=http://localhost:18080/realms/wagering
OIDC_AUDIENCE=wagering-api
OIDC_CLIENT_ID=wagering-api
OIDC_CLIENT_SECRET=local-api-secret
